# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/forno?retryWrites=true&w=majority

# JWT Secrets (use long random strings in production)
JWT_USER_SECRET=change-me-user-secret-32-chars-min
JWT_ADMIN_SECRET=change-me-admin-secret-32-chars-min

# Razorpay credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Google OAuth 2.0 Client ID (https://console.cloud.google.com/apis/credentials)
# Must be the SAME client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env.
# Leave empty to keep Google sign-in disabled (endpoint returns 503).
GOOGLE_CLIENT_ID=

# Server
PORT=5000
NODE_ENV=development

# In development, skip email verification (users are auto-verified on register)
# Set to "false" and configure SMTP below in production
SKIP_EMAIL_VERIFICATION=true

# SMTP (only needed in production / when SKIP_EMAIL_VERIFICATION=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Forno <no-reply@forno.com>

# Frontend origin for CORS (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000
